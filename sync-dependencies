#!/bin/sh
# Installs the project's dependencies into node_modules when package.json, pnpm-lock.yaml,
# pnpm-workspace.yaml or .npmrc has changed since the last install there, then runs the given
# command.
#
# Dev containers keep node_modules in a named volume, off the host. Docker fills such a volume
# from the image only when it creates the volume, so a rebuilt image never reaches an existing
# one, and a dependency change would otherwise leave every later container on the old packages.
# Each project's `scripts/dx` runs its commands through this, from the project's directory.
#
# A stamp in node_modules records the manifests of the last install, so an unchanged project
# costs one hash. A lock on node_modules itself, which an install may empty but never removes,
# keeps parallel commands from installing into the shared volume at once, and the check is
# repeated under the lock, so only the first of them installs. A failed install writes no stamp,
# so the next command tries again.
#
# A project without pnpm-lock.yaml is left alone, and so is a pnpm command that changes the
# dependencies itself, such as `pnpm install` or `pnpm add`: it installs anyway, and a frozen
# install ahead of it would fail on the very lockfile it is about to update.
#
# Usage: sync-dependencies [command [argument...]]
set -e

# Prints pnpm's command, the first argument that is neither an option nor an option's value.
pnpm_command() {
	shift
	while [ $# -gt 0 ]; do
		case $1 in
			-C | --dir | -F | --filter | --filter-prod | --reporter | --loglevel | --workspace-concurrency)
				[ $# -gt 1 ] && shift ;;
			-*) ;;
			*) printf '%s\n' "$1"; return ;;
		esac
		shift
	done
}

sync=yes
[ -f package.json ] && [ -f pnpm-lock.yaml ] || sync=no
if [ "${1:-}" = pnpm ]; then
	case $(pnpm_command "$@") in
		install | i | add | update | up | upgrade | remove | rm | uninstall | un | dedupe | import | prune) sync=no ;;
	esac
fi

if [ "$sync" = yes ]; then
	manifests="package.json pnpm-lock.yaml"
	for file in pnpm-workspace.yaml .npmrc; do
		if [ -f "$file" ]; then manifests="$manifests $file"; fi
	done
	# The names are fixed and contain no spaces, so the list splits safely.
	want=$(cat $manifests | sha256sum)
	stamp=node_modules/.sync-dependencies
	if [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
		mkdir -p node_modules
		exec 9<node_modules
		flock 9
		if [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
			echo "sync-dependencies: installing the changed dependencies into node_modules" >&2
			pnpm install --frozen-lockfile --ignore-scripts --config.confirm-modules-purge=false >&2
			printf '%s\n' "$want" > "$stamp"
		fi
		exec 9>&-
	fi
fi

if [ $# -gt 0 ]; then exec "$@"; fi
